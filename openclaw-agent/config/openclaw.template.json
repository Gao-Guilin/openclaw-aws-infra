{
  "agents": {
    "defaults": {
      "workspace": "__OPENCLAW_WORKSPACE__",
      "timeoutSeconds": 600,
      "models": {
        "deepseek/deepseek-v4-flash": {
          "alias": "DeepSeek Flash"
        },
        "deepseek/deepseek-v4-pro": {
          "alias": "DeepSeek Pro"
        }
      },
      "model": {
        "primary": "deepseek/deepseek-v4-flash"
      }
    },
    "profiles": {
      "test": {
        "model": {
          "primary": "deepseek/deepseek-v4-flash"
        }
      },
      "inspection": {
        "model": {
          "primary": "deepseek/deepseek-v4-flash"
        }
      },
      "reporting": {
        "model": {
          "primary": "deepseek/deepseek-v4-pro"
        }
      },
      "summary": {
        "model": {
          "primary": "deepseek/deepseek-v4-pro"
        }
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "__OPENCLAW_GATEWAY_TOKEN__"
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": false
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "coding"
  },
  "plugins": {
    "entries": {
      "deepseek": {
        "enabled": true
      },
      "qqbot": {
        "enabled": "__QQBOT_ENABLED__"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "api": "openai-completions",
        "apiKey": {
          "source": "env",
          "id": "__DEEPSEEK_API_KEY__"
        },
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0.14,
              "output": 0.28,
              "cacheRead": 0.028,
              "cacheWrite": 0
            },
            "contextWindow": 1000000,
            "maxTokens": 384000,
            "compat": {
              "supportsReasoningEffort": true,
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            },
            "api": "openai-completions"
          },
          {
            "id": "deepseek-v4-pro",
            "name": "DeepSeek V4 Pro",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 1.74,
              "output": 3.48,
              "cacheRead": 0.145,
              "cacheWrite": 0
            },
            "contextWindow": 1000000,
            "maxTokens": 384000,
            "compat": {
              "supportsReasoningEffort": true,
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            },
            "api": "openai-completions"
          }
        ]
      }
    }
  },
  "auth": {
    "profiles": {
      "deepseek:default": {
        "provider": "deepseek",
        "mode": "api_key"
      }
    }
  },
  "skills": {
    "load": {
      "extraDirs": [
        "/app/skills"
      ]
    },
    "entries": {
      "aws-task-healthcheck": {
        "enabled": true
      },
      "aws-daily-inspection": {
        "enabled": true
      },
      "aws-cost-inspection": {
        "enabled": true
      },
      "aws-alert-analysis": {
        "enabled": true
      },
      "aws-report-generation": {
        "enabled": true
      }
    }
  },
  "channels": {
    "qqbot": {
      "enabled": "__QQBOT_ENABLED__",
      "allowFrom": [
        "*"
      ],
      "appId": "__QQBOT_APP_ID__",
      "clientSecret": "__QQBOT_CLIENT_SECRET__",
      "name": "__QQBOT_NAME__"
    }
  },
  "bindings": [
    {
      "agentId": "main",
      "match": {
        "channel": "qqbot",
        "accountId": "default"
      }
    }
  ],
  "meta": {
    "lastTouchedVersion": "2026.6.11",
    "templateFor": "openclaw-aws-agent",
    "notes": {
      "deepseek-v4-flash": "Default model for test, healthcheck and lightweight inspection tasks.",
      "deepseek-v4-pro": "Reserved for report generation, log summarization, weekly summaries and heavier reasoning tasks.",
      "secretInjection": "DeepSeek API key, gateway token and QQBot credentials must be injected at runtime through environment variables or AWS Secrets Manager."
    }
  }
}
